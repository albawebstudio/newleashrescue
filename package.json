{
  "name": "new-leash-rescue-nuxt-app",
  "version": "1.1.0",
  "description": "A Nuxt 3/Vue 3 application for New Leash Rescue, a non-profit no-kill pet rescue, showcasing adoptable pets and supporting donations.",
  "keywords": [
    "nuxt4",
    "vue3",
    "pet-adoption",
    "animal-rescue",
    "no-kill-shelter",
    "non-profit",
    "cloudflare-pages"
  ],
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "homepage": "https://github.com/andrewalba/newleashrescue#readme",
  "bugs": {
    "url": "https://github.com/andrewalba/newleashrescue/issues",
    "email": "bugs@albawebstudio.com"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/andrewalba/newleashrescue/blob/main/LICENSE"
    }
  ],
  "author": "Alba Web Studio LLC <support@albawebstudio.com> (https://albaweb.studio)",
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/albawebstudio"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
