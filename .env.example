# GOOGLE TAG
GA_ID=

# SITE DATA (local dev / build default; Cloudflare uses NUXT_PUBLIC_SITE_URL in wrangler.toml)
SITE_URL=https://newleashrescue.org

# RESEND
RESEND_API_KEY=
RESEND_TEMPLATE_ID=
CONTACT_NAME=New Leash Rescue
# Must be a sender on a domain verified by Resend.
CONTACT_EMAIL=website@newleashrescue.org
TO_EMAIL=adopt@newleashrescue.org
ADOPTION_TO_EMAIL=adopt@newleashrescue.org
FOSTER_TO_EMAIL=adopt@newleashrescue.org
VOLUNTEER_TO_EMAIL=adopt@newleashrescue.org
